TabbedContent {
  background: $surface;

  Tabs {
    padding: 0 1 0 1;
    margin-top: 1;
  }

  Tab {
    text-style: bold;
  }
}

ChecklistView {
  & > ChecklistRow {
    background: $surface;
    border: round $panel-lighten-3;

    &.-highlight {
      border: round $primary-darken-3;
    }

    & > Static {
      padding: 1;
    }
  }

  &:focus {
    & > ChecklistRow.-highlight {
      border: round $primary;
    }
  }

  & > .checklist--kept,
  & > .track--default {
    color: $success;
    text-style: bold;
  }
  & > .checklist--removed,
  & > .track--forced {
    color: $error;
    text-style: bold;
  }

  & > .checklist--name {
    text-style: bold;
  }
  & > .checklist--name-removed {
    color: $text-muted;
    text-style: strike;
  }
  & > .checklist--unnamed,
  & > .attachment--description {
    color: $text-muted;
    text-style: italic;
  }
  & > .checklist--meta {
    color: $text-muted;
  }

  & > .track--sync {
    color: $warning;
    text-style: italic;
  }

  & > .track--video {
    color: $accent;
    text-style: bold;
  }
  & > .track--audio {
    color: $secondary;
    text-style: bold;
  }
  & > .track--subtitles {
    color: $warning;
    text-style: bold;
  }
  & > .track--other {
    color: $text-muted;
    text-style: bold;
  }
}

EditScreen,
DelayScreen,
ProgressBarScreen,
FontsScreen,
PickFolderScreen {
  align: center middle;

  Container {
    width: 85%;
    min-height: 10;

    border: $border;
    background: $panel;
    border-title-color: $text;
    border-title-background: $panel;
    border-subtitle-color: $text-muted;
    border-subtitle-background: $panel;
  }
}

EditScreen,
PickFolderScreen {
  Container {
    height: auto;
    padding: 1;

    Input {
      padding: 0 1;
      margin-bottom: 1;
    }

    Horizontal {
      align: center middle;
      height: auto;
      margin-top: 1;

      Button {
        min-width: 50%;
        margin: 0 1;
      }
    }
  }
}

DelayScreen {
  Container {
    height: auto;
    padding: 1;

    #delay-row {
      align: center middle;
      height: auto;
      margin-bottom: 1;

      Input {
        width: 1fr;
        text-align: center;
        margin: 0 1;
      }

      Button {
        min-width: 5;
      }
    }

    #action-row {
      align: center middle;
      height: auto;
      margin-top: 1;

      Button {
        min-width: 0;
        width: 1fr;
        margin: 0 1;
      }
    }
  }
}

NoticeWidget {
  height: 100%;
  background: $background-lighten-1;
  border: round $secondary;
  content-align: center middle;
  color: $primary-lighten-3;
}

FontsScreen {
  Container {
    height: 80%;

    #fonts-note {
      height: auto;
      padding: 0 1;
      margin-bottom: 1;
      color: $warning;
      text-style: italic;
    }

    #fonts-table {
      height: 1fr;
    }
  }
}

ProgressBarScreen {
  Container {
    height: 30%;
  }

  Bar {
    width: 50;
  }
}

PickFolderScreen {
  Container {
    Input {
      width: 1fr;
    }

    #folder-row {
      Button {
        min-width: 10;
        margin-left: 1;
      }
    }
  }
}
